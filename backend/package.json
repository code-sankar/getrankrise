{
  "name": "backend",
  "type": "module",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon -r dotenv/config server.js",
    "start": "node server.js",
    "migrate":          "node migrate.js up",
    "migrate:status":   "node migrate.js status",
    "migrate:baseline": "node migrate.js baseline",
    "migrate:check":    "node migrate.js pending",
    "//test": "Integration tests run against a REAL Postgres — point DB_NAME at a throwaway database, the helpers TRUNCATE. --test-concurrency=1 is required: Node runs each test FILE in its own process, and parallel files would truncate each other's fixtures mid-run.",
    "test":             "node --test --test-concurrency=1 -r dotenv/config \"tests/**/*.test.js\"",
    "test:watch":       "node --test --test-concurrency=1 --watch -r dotenv/config \"tests/**/*.test.js\""
  },
  "keywords": [
    "user authentication",
    "backend",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "Sankar",
  "license": "ISC",
  "description": "This is the backend for the user authentication system. It is built using Node.js, Express, and PostgreSQL.",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "pg-connection-string": "^2.12.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "umzug": "^3.8.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
