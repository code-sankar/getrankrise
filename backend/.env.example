# ══════════════════════════════════════════════════════════════════════════════
# GetRankRise — backend/.env
#
# Rule for this file: every key below is read somewhere in src/. Nothing here
# is decorative. Keys marked REQUIRED are in the REQUIRED[] array in
# src/config/env.js — the process exits at boot if any is empty.
#
# NOTE ON INLINE COMMENTS: dotenv v16+ strips a trailing "# ..." from unquoted
# values, but if a secret itself contains "#", wrap the value in quotes.
# ══════════════════════════════════════════════════════════════════════════════


# ── Server ────────────────────────────────────────────────────────── REQUIRED
PORT=5000
NODE_ENV=development


# ── Database (PostgreSQL) ─────────────────────────────────────────── REQUIRED
# All five must be non-empty or env.js exits. Empty string counts as missing.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=getrankrise
DB_USER=postgres
DB_PASSWORD=


# ── JWT ───────────────────────────────────────────────────────────── REQUIRED
# Generate real values — do NOT ship the placeholder strings:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d


# ── Public URLs ───────────────────────────────────────────────────────────────
# CLIENT_URL (REQUIRED) is the single source for the frontend origin: CORS,
# the Paddle checkout success redirect, and every OAuth return. The old
# FRONTEND_URL alias was REMOVED from paddle.client.js — delete it from .env,
# having both is how checkouts silently redirect to the wrong host.
CLIENT_URL=http://localhost:5173

# ── Refresh-token cookie SameSite policy ──────────────────────────────────────
# Controls whether the httpOnly refresh cookie survives a SPLIT-DOMAIN deploy.
# Leave unset unless you know you need it:
#   unset + NODE_ENV=production   → "none" + Secure. Correct when the SPA and
#                                   the API are on DIFFERENT registrable
#                                   domains (e.g. app on *.vercel.app, API
#                                   elsewhere). This is the safe default: with
#                                   "strict" the browser never sends the cookie
#                                   cross-site, /auth/refresh-token 401s every
#                                   time, and every user is logged out the
#                                   moment their 15-minute access token expires.
#   unset + development           → "lax" (http://localhost can't use "none",
#                                   which browsers only accept with Secure).
#   lax                           → set this when the app and API SHARE a
#                                   registrable domain (getrankrise.com +
#                                   api.getrankrise.com). Stronger CSRF posture;
#                                   only correct on that topology.
#   strict                        → strongest, same-site only. Breaks any
#                                   cross-site deploy.
# "none" is always forced to Secure=true — browsers drop it otherwise.
# COOKIE_SAMESITE=

# API_PUBLIC_URL is the base URL third parties can reach for callbacks:
#   Google OAuth callback   → {API_PUBLIC_URL}/api/v1/oauth/google/callback
#   Facebook OAuth callback → {API_PUBLIC_URL}/api/v1/oauth/facebook/callback
#   Twilio inbound STOP     → {API_PUBLIC_URL}/api/v1/webhooks/sms/inbound
#                             (the HMAC is computed over this exact URL, so it
#                              must match what's configured in Twilio byte for byte)
#
# ⚠ BOOT TRAP: env.js treats GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET +
#   API_PUBLIC_URL as all-or-nothing. Setting API_PUBLIC_URL while the two
#   Google vars are blank exits the process. Either fill all three, or keep
#   this line commented until you do. See the note in the accompanying summary
#   about moving API_PUBLIC_URL out of that triad — it is no longer
#   Google-specific.
API_PUBLIC_URL=http://localhost:5000


# ── Token encryption at rest ──────────────────────────────────────────────────
# AES-256-GCM key for OAuth tokens in platform_connections. 64 hex chars.
# env.js REFUSES TO BOOT if Google OAuth is configured and this is empty.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Set only during a key rotation window (old key, for decrypt-only fallback).
TOKEN_ENCRYPTION_KEY_PREVIOUS=


# ── Google Business Profile ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true → listAccounts/listLocations return fixture data so the connect flow is
# testable while GBP API access is pending. Consent + code exchange still hit
# real Google. NEVER true in production.
GOOGLE_MOCK_DISCOVERY=false


# ── Yelp (Fusion — read only, no reply publishing) ────────────────────────────
YELP_API_KEY=


# ── Facebook (Graph API — Page ratings) ───────────────────────────────────────
# Needs pages_show_list + pages_read_engagement, which require App Review
# before they work on Pages you don't personally administer.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
# true → mock Page discovery so the connect flow is testable pre-App-Review.
FACEBOOK_MOCK_DISCOVERY=false


# ── Review sync pipeline ──────────────────────────────────────────────────────
# REVIEWS_MOCK forces the deterministic mock provider for EVERY platform —
# a fully offline sync → upsert → dashboard → analytics chain with zero
# third-party credentials. Refuses to run in production.
REVIEWS_MOCK=false

# Background loop kill-switches (server.js). Leave false on a single-instance
# deploy; set true on HTTP-only instances once web/worker roles are split.
SYNC_SCHEDULER_DISABLED=false
CAMPAIGN_RUNNER_DISABLED=false


# ── OpenAI (AI reply drafts) ──────────────────────────────────────────────────
OPENAI_API_KEY=


# ── Twilio (international SMS + ALL WhatsApp) ───────────────── REQUIRED IN PROD
# Missing credentials = simulated sends in DEVELOPMENT only. In production the
# process now REFUSES TO BOOT without all three, because a simulated send is
# indistinguishable from a real one to every caller: the campaign marks the
# recipient "sent", increments sent_count, spends the clinic's credit, and no
# patient receives anything. There is no error anywhere to find afterwards.
#
# MSG91 does NOT satisfy this requirement — Twilio carries international SMS and
# every WhatsApp message on every plan.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# ⚠ WhatsApp routes through Twilio for EVERY country, India included — MSG91's
# sendWhatsApp throws "not implemented". Without this var every WhatsApp send
# silently simulates, which quietly kills the Premium plan's headline channel.
# Sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=


# ── MSG91 (domestic Indian SMS only) ─────────────────────────────────── OPTIONAL
# A COST OPTIMISATION, not a capability: Twilio delivers to Indian numbers too,
# just at a higher price. All three are required TOGETHER — SENDER_ID and
# TEMPLATE_ID must be DLT-registered with TRAI or MSG91 rejects the send, so
# env.js exits on a partial set.
#
# Leave the whole block empty and Indian SMS routes to Twilio. (It used to route
# to MSG91 unconditionally, so an unfilled block here meant every domestic
# Indian message silently simulated while Twilio sat there able to deliver it.)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ── Escape hatch: production instance that never sends ────────────────────────
# Set true ONLY for a production role that legitimately sends nothing (a
# read-only analytics replica, or a web instance running with
# CAMPAIGN_RUNNER_DISABLED=true). It bypasses the boot-time Twilio requirement.
# Sends still THROW rather than simulate, so a mistake surfaces as a failed
# campaign rather than a silently undelivered one.
# ALLOW_SIMULATED_SENDS=false


# ── SendGrid (transactional review-request email) ─────────────────────────────
# FROM_EMAIL must be a sender/domain YOU have verified in SendGrid — it's the
# platform's sending identity, not the clinic's domain. SendGrid rejects mail
# from unverified addresses.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reviews@getrankrise.com
SENDGRID_FROM_NAME=GetRankRise
# Dev only — pretend-send, no API call. Ignored when NODE_ENV=production.
#
# This now covers ACCOUNT mail as well as review requests: password reset,
# email confirmation and team invitations. With EMAIL_SIMULATE=true the link is
# printed to the server log ("[email] SIMULATED → … link: http://…"), which is
# the only way to complete any of those three flows on a box with no SendGrid
# key. env.js refuses to boot with this set in production, so a live token can
# never be logged there.
#
# ⚠ WITHOUT a working mailer (real key OR simulate), three things change:
#   * POST /auth/forgot-password returns 503 — there is no way to send a link,
#     and pretending otherwise would leave people waiting on an email that was
#     never going to arrive.
#   * Team invitations are refused for the same reason: an invitation IS an
#     email, and a pending row nobody can accept looks identical to a sent one.
#   * requireVerifiedEmail STOPS ENFORCING. Demanding that someone confirm an
#     address over a channel we do not have is a lockout, not a security
#     control. Configure email to turn the send gate on.
EMAIL_SIMULATE=true


# ── Error monitoring ──────────────────────────────────────────────────────────
# Unset is a supported configuration, not a broken one: reportError ALWAYS
# writes one structured JSON line to stderr, which is what a platform log
# aggregator (CloudWatch, Railway, Render, Loki) needs to be searchable. Sentry
# is layered on top when this is set — if it is misconfigured or down, the log
# line is still there.
#
# Format: https://<publicKey>@<host>/<projectId>  (Sentry → Project → Client Keys)
# A DSN that cannot be parsed WARNS and falls back rather than failing boot;
# monitoring being misconfigured must not take the product down.
SENTRY_DSN=
# Ties an event to the commit that produced it. Auto-detected from
# RAILWAY_GIT_COMMIT_SHA / RENDER_GIT_COMMIT / GIT_COMMIT when present.
SENTRY_RELEASE=


# ── Competitor Intelligence ───────────────────────────────────────────────────
# Provider is auto-selected by key presence, in this order:
#   APIFY_TOKEN → Apify   |   DATAFORSEO_* → DataForSEO   |   neither → mock
# With both blank the tracker runs forever on deterministic fake metrics and
# never errors — so an unfilled block here looks like a working feature.
APIFY_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=


# ── Paddle Billing v2 (Merchant of Record) ────────────────────────────────────
# All four below are all-or-nothing: env.js exits on a partial set, because a
# half-configured Paddle accepts payments whose webhooks it cannot verify.
# PADDLE_ENVIRONMENT is exempt (safe default: sandbox).
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_PREMIUM=
