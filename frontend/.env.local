# Local development environment for the Vite dev server.
#
# VITE_* vars are inlined into the bundle at BUILD time, so anything here is
# public. Never put a secret in this file.

# Base URL of the backend API, including the /api/v1 prefix.
#
# Optional locally (axios.helper.js falls back to http://localhost:5000/api/v1
# in dev), but REQUIRED for any production build — that fallback is dev-only
# and the module throws without it rather than silently shipping a bundle that
# calls localhost. Set the same key in your host's build environment
# (Vercel → Settings → Environment Variables).
VITE_API_URL=http://localhost:5000/api/v1

# ── Paddle (client-side checkout) ────────────────────────────────────────────
# Needed only when exercising the upgrade flow locally. VITE_PADDLE_ENV is
# "sandbox" or "production"; the client token is the public one from
# Paddle → Developer Tools → Authentication.
# VITE_PADDLE_ENV=sandbox
# VITE_PADDLE_CLIENT_TOKEN=

# NOTE: VITE_MOCK_AUTH used to be set here. It was read NOWHERE in src/ — the
# demo-login gate keys off import.meta.env.DEV (see src/mocks/mockAuth.js), so
# the flag did nothing, and setting it to false gave a false sense that demo
# auth had been turned off. Removed rather than wired up: DEV is the correct
# gate, because it is guaranteed false in `vite build`.
